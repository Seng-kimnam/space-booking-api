# App
NODE_ENV=development
PORT=3000
## JWT
JWT_SECRET=your_secret_key
JWT_ACCESS_EXPIRES_IN=15m.

# Database (NestJS runs on the host, so use localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=db_user
DB_PASSWORD=change_me
DB_NAME=space_booking

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# pgAdmin (local only; connect to the server with host "db", port 5432)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# Mailpit (local SMTP testing)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=no-reply@space-booking.local
MAILPIT_UI_PORT=8025

# Logging (NestJS built-in ConsoleLogger)
# LOG_FORMAT: json | pretty (default: json in production, pretty otherwise)
LOG_FORMAT=pretty
# Dev only: also write JSON lines here so Grafana Alloy can ship them to Loki.
# Leave empty to disable. Production logs to stdout instead.
LOG_FILE=logs/app.log

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_PORT=3001

# Loki / Alloy
LOKI_PORT=3100
LOKI_RETENTION_PERIOD=168h
ALLOY_PORT=12345

# --- Telegram bot
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=replace-with-random-32+chars
TELEGRAM_WEBHOOK_URL=
TELEGRAM_LINK_TTL_MINUTES=10

# --- Bookings ---
QR_CHECKIN_EARLY_MINUTES=15

#--- Google OAuth2 ------

GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_CALLBACK_URL=you-callback-url

# ---- RabbitMQ (docs/integration/lms-booking-events-now.md) 
# space-booking-api/.env
RABBITMQ_URL=amqp://space-booking:space-booking-dev@localhost:5672/space-library-dev
LIBRARY_INTEGRATION_ENABLED=true
LMS_BASE_URL=http://localhost:3010
LMS_API_KEY=dev-shared-key-0123456789
OUTBOX_RELAY_BATCH=100

RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=admin_dev
