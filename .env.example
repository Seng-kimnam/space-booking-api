# App
NODE_ENV=development
PORT=3000
JWT_SECRET=your_secret_key

# Database (NestJS runs on the host, so use localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=db_user
DB_PASSWORD=change_me
DB_NAME=space_booking

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# pgAdmin (local only; connect to the server with host "db", port 5432)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# Mailpit (local SMTP testing)
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025

# Logging (NestJS built-in ConsoleLogger)
# LOG_FORMAT: json | pretty (default: json in production, pretty otherwise)
LOG_FORMAT=pretty
# Dev only: also write JSON lines here so Grafana Alloy can ship them to Loki.
# Leave empty to disable. Production logs to stdout instead.
LOG_FILE=logs/app.log

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_PORT=3001

# Loki / Alloy
LOKI_PORT=3100
LOKI_RETENTION_PERIOD=168h
ALLOY_PORT=12345
