# App
NODE_ENV=development
PORT=3000
JWT_SECRET=your_secret_key

# Database (NestJS runs on the host, so use localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=db_user
DB_PASSWORD=change_me
DB_NAME=space_booking

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# pgAdmin (local only; connect to the server with host "db", port 5432)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# Mailpit (local SMTP testing)
MAIL_HOST=localhost
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
