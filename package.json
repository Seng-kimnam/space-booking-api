    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/microservices": "^12.3.3",
    "@nestjs/passport": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.2.1",
    "argon2": "^0.45.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.4.0",
