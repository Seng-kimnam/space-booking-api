// Development: the API runs on the host and writes JSON lines to ./logs
// (LOG_FILE=logs/app.log). That folder is mounted read-only at
// /var/log/space-booking, and Alloy tails it into Loki.
// Docs: https://grafana.com/docs/alloy/latest/reference/components/loki/loki.source.file/

local.file_match "app_logs" {
  path_targets = [{
    "__path__"     = "/var/log/space-booking/*.log",
    "service_name" = "space-booking-api",
    "env"          = "development",
  }]
  sync_period = "5s"
}

// New files are read from the start; afterwards Alloy resumes from the
// position saved in its storage volume, so nothing is sent twice.
loki.source.file "app_logs" {
  targets    = local.file_match.app_logs.targets
  forward_to = [loki.process.nest_json.receiver]
}

// Parse Nest's ConsoleLogger JSON: {"level","pid","timestamp","message","context",...}
loki.process "nest_json" {
  stage.json {
    expressions = {
      level     = "level",
      context   = "context",
      timestamp = "timestamp",
    }
  }

  // Low-cardinality fields only, as labels.
  stage.labels {
    values = {
      level = "",
    }
  }

  stage.structured_metadata {
    values = {
      context = "",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "UnixMs"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
