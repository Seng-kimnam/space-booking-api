{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://space-booking.local/schemas/place.snapshot.v1.json",
  "title": "place.created / place.updated data v1 (LMS -> Space Booking)",
  "description": "The full place, every time. Applied only if revision is greater than the last applied one. Areas and seats not in the snapshot are removed on our side.",
  "type": "object",
  "required": [
    "placeId",
    "code",
    "revision",
    "name",
    "description",
    "address",
    "lat",
    "lng",
    "timezone",
    "status",
    "bookingEnabled",
    "openingHours",
    "closures",
    "areas",
    "seats"
  ],
  "properties": {
    "placeId": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_-]{1,64}$"
    },
    "code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 30
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "+1 per committed change, per place"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2000
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "lat": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "IANA name"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "INACTIVE"
      ]
    },
    "bookingEnabled": {
      "type": "boolean"
    },
    "openingHours": {
      "type": "array",
      "maxItems": 7,
      "description": "Local times. A missing weekday means closed.",
      "items": {
        "type": "object",
        "required": [
          "weekday",
          "open",
          "close",
          "closesNextDay"
        ],
        "properties": {
          "weekday": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "description": "0 = Sunday"
          },
          "open": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "close": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "closesNextDay": {
            "type": "boolean"
          }
        }
      }
    },
    "closures": {
      "type": "array",
      "maxItems": 366,
      "description": "Local dates, from place-local today onward",
      "items": {
        "type": "object",
        "required": [
          "date",
          "reason"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 255
          }
        }
      }
    },
    "areas": {
      "type": "array",
      "maxItems": 500,
      "description": "Bookable areas only",
      "items": {
        "type": "object",
        "required": [
          "areaId",
          "name",
          "floor",
          "type",
          "description",
          "status"
        ],
        "properties": {
          "areaId": {
            "type": "string",
            "pattern": "^[0-9A-Za-z_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "floor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 30
          },
          "type": {
            "type": [
              "string",
              "null"
            ],
            "description": "READING_ROOM, QUIET_ZONE, GROUP_STUDY, COMPUTER_LAB, OTHER. Ignored by Space Booking in v1."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      }
    },
    "seats": {
      "type": "array",
      "maxItems": 5000,
      "description": "Bookable, non-retired seats only",
      "items": {
        "type": "object",
        "required": [
          "seatId",
          "areaId",
          "label",
          "features",
          "status"
        ],
        "properties": {
          "seatId": {
            "type": "string",
            "pattern": "^[0-9A-Za-z_-]{1,64}$"
          },
          "areaId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9A-Za-z_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "maxProperties": 30
          },
          "status": {
            "enum": [
              "ACTIVE",
              "MAINTENANCE",
              "UNAVAILABLE"
            ]
          }
        }
      }
    }
  }
}
